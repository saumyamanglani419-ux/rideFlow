# Copy this file to .env and adjust. Never commit your real .env.

# ---- MongoDB (one local server, one database per service) ----
MONGODB_URI=mongodb://127.0.0.1:27017
USER_DB_NAME=rideflow_users
DRIVER_DB_NAME=rideflow_drivers
RIDE_DB_NAME=rideflow_rides

# ---- Security ----
# Generate your own values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=600000
INTERNAL_API_KEY=replace-me-with-another-random-string

# ---- Service URLs (used by the Ride Service) ----
# 127.0.0.1 instead of "localhost" avoids slow IPv6 lookups on some machines.
DRIVER_SERVICE_URL=http://127.0.0.1:8002
FARE_SERVICE_URL=http://127.0.0.1:8004
SERVICE_TIMEOUT_SECONDS=5

# ---- Pricing (Fare Service) ----
BASE_FARE=50
PER_KM_RATE=12
MINIMUM_FARE=80
CURRENCY=INR

# ---- Matching (Driver Service) ----
MAX_DRIVER_SEARCH_KM=10
